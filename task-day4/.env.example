# Example environment variables for this project
# Copy this file to `.env` at the project root and fill values.
# Do NOT commit your real `.env` file to version control.

# Private key used by deployment scripts (replace with your own)
PRIVATE_KEY=your_private_key_here

# Backend - PostgreSQL (transactions)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb
TYPEORM_SYNC=true

# Backend - MongoDB (event/logs)
# Either use a single URI or host/port/db below
# MONGODB_URI=mongodb://localhost:27017/appdb
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=appdb
